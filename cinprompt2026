    <!-- كود المنطق والتشغيل التفاعلي -->
    <script>
        let currentType = 'video';
        let currentMediaUrl = '';

        const sampleVideos = [
            "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/TearsOfSteel.mp4",
            "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/Sintel.mp4"
        ];
        const sampleImages = [
            "https://images.unsplash.com/photo-1534447677768-be436bb09401?q=80&w=1000&auto=format&fit=crop",
            "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=1000&auto=format&fit=crop",
            "https://images.unsplash.com/photo-1509198397868-475647b2a1e5?q=80&w=1000&auto=format&fit=crop"
        ];
        const sampleAudios = [
            "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3"
        ];

        function setType(type) {
            currentType = type;
            ['video', 'image', 'audio'].forEach(t => {
                const btn = document.getElementById(`btn-${t}`);
                if (t === type) {
                    btn.className = "py-3 rounded-xl text-xs font-bold bg-cyan-500 text-slate-950 transition shadow-lg shadow-cyan-500/20 flex items-center justify-center gap-1.5";
                } else {
                    btn.className = "py-3 rounded-xl text-xs font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 transition flex items-center justify-center gap-1.5";
                }
            });
        }

        function startGeneration() {
            const userIdea = document.getElementById('userIdea').value;
            if (!userIdea.trim()) {
                alert("المرجو كتابة وصف للمشهد أولاً!");
                return;
            }

            const btn = document.getElementById('generateBtn');
            const progressSection = document.getElementById('progressSection');
            const progressBar = document.getElementById('progressBar');
            const progressPercent = document.getElementById('progressPercent');
            const statusText = document.getElementById('statusText');
            const playerSection = document.getElementById('playerSection');

            btn.disabled = true;
            btn.classList.add('opacity-50');
            progressSection.classList.remove('hidden');
            playerSection.classList.add('hidden');

            let progress = 0;
            const steps = [
                "تحليل الفكرة والإضاءة...",
                "بناء الهيكل الثلاثي الأبعاد...",
                "معالجة الألوان والدقة (8K Render)...",
                "إنهاء التصدير السينمائي..."
            ];

            const interval = setInterval(() => {
                progress += 5;
                progressBar.style.width = progress + '%';
                progressPercent.textContent = progress + '%';

                if (progress < 30) statusText.textContent = steps[0];
                else if (progress < 60) statusText.textContent = steps[1];
                else if (progress < 90) statusText.textContent = steps[2];
                else statusText.textContent = steps[3];

                if (progress >= 100) {
                    clearInterval(interval);
                    setTimeout(() => {
                        progressSection.classList.add('hidden');
                        btn.disabled = false;
                        btn.classList.remove('opacity-50');
                        renderResult(userIdea);
                    }, 400);
                }
            }, 100);
        }

        function renderResult(idea) {
            const playerSection = document.getElementById('playerSection');
            const mediaImage = document.getElementById('mediaImage');
            const mediaVideo = document.getElementById('mediaVideo');
            const mediaAudio = document.getElementById('mediaAudio');
            const videoControls = document.getElementById('videoControls');
            const outputBadge = document.getElementById('outputBadge');
            const resultTitle = document.getElementById('resultTitle');

            mediaImage.classList.add('hidden');
            mediaVideo.classList.add('hidden');
            mediaAudio.classList.add('hidden');
            videoControls.classList.add('hidden');

            resultTitle.textContent = idea.substring(0, 45) + (idea.length > 45 ? "..." : "");

            if (currentType === 'video') {
                currentMediaUrl = sampleVideos[Math.floor(Math.random() * sampleVideos.length)];
                mediaVideo.src = currentMediaUrl;
                mediaVideo.classList.remove('hidden');
                videoControls.classList.remove('hidden');
                outputBadge.textContent = "📹 فيديو سينمائي 8K";
                mediaVideo.play();
                document.getElementById('playBtn').textContent = '❚❚';
            } else if (currentType === 'image') {
                currentMediaUrl = sampleImages[Math.floor(Math.random() * sampleImages.length)];
                mediaImage.src = currentMediaUrl;
                mediaImage.classList.remove('hidden');
                outputBadge.textContent = "🖼️ صورة سينمائية High-Res";
            } else if (currentType === 'audio') {
                currentMediaUrl = sampleAudios[0];
                document.getElementById('audioControl').src = currentMediaUrl;
                mediaAudio.classList.remove('hidden');
                outputBadge.textContent = "🎵 مقطع صوتي سينمائي";
            }

            playerSection.classList.remove('hidden');
            addToGallery(idea, currentType, currentMediaUrl);
        }

        function togglePlay() {
            const mediaVideo = document.getElementById('mediaVideo');
            const playBtn = document.getElementById('playBtn');
            if (mediaVideo.paused) {
                mediaVideo.play();
                playBtn.textContent = '❚❚';
            } else {
                mediaVideo.pause();
                playBtn.textContent = '▶';
            }
        }

        function downloadMedia() {
            if (!currentMediaUrl) return;
            const a = document.createElement('a');
            a.href = currentMediaUrl;
            a.target = '_blank';
            a.download = `CinePrompt_${Date.now()}`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        function addToGallery(title, type, url) {
            const gallerySection = document.getElementById('gallerySection');
            const galleryGrid = document.getElementById('galleryGrid');
            gallerySection.classList.remove('hidden');

            const item = document.createElement('div');
            item.className = "bg-slate-900 border border-slate-800 rounded-xl overflow-hidden group relative aspect-video cursor-pointer";
            
            let content = '';
            if (type === 'image') {
                content = `<img src="${url}" class="w-full h-full object-cover group-hover:scale-105 transition">`;
            } else if (type === 'video') {
                content = `<video src="${url}" class="w-full h-full object-cover"></video><div class="absolute inset-0 bg-black/30 flex items-center justify-center text-white text-xs font-bold">📹 فيديو</div>`;
            } else {
                content = `<div class="w-full h-full bg-indigo-950 flex items-center justify-center text-white text-xs font-bold">🎵 صوت سينمائي</div>`;
            }

            item.innerHTML = content;
            galleryGrid.prepend(item);
        }
    </script>
</body>
</html>
